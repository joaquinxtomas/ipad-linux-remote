#!/usr/bin/env bash
set -euo pipefail

script_dir=$(readlink -f "$(dirname "${BASH_SOURCE[0]}")")
tailscale_ip=$(tailscale ip -4)
[[ $tailscale_ip =~ ^100\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
    echo "Tailscale has no active IPv4 address" >&2
    exit 1
}

exec env REMOTE_DESKTOP_WEB_BIND="$tailscale_ip" "$script_dir/start-desktop"
